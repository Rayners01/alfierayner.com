# Spotify — powers the "now playing" tile.
#
# 1. Create an app at https://developer.spotify.com/dashboard and copy the
#    client ID and secret into the two variables below.
# 2. Add http://127.0.0.1:8888/callback to the app's Redirect URIs.
#    (Spotify rejects the hostname `localhost`; it must be the IP literal.)
# 3. Run `npm run spotify:token` and paste the result into the third variable.
#
# Refresh tokens do not expire, so step 3 is only needed once — or again if the
# token is revoked or the client secret is rotated.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# PostgreSQL — users, sessions and the photo library.
#
# Create the database first:
#   createdb alfierayner
# Then apply the schema and seed the existing photos:
#   npm run db:migrate && npm run user:create && npm run db:seed
DATABASE_URL=postgres://localhost:5432/alfierayner

# Where uploaded images are written. Defaults to ./var/uploads — outside
# public/, because `next start` serves public/ from a build-time snapshot and
# would 404 anything written at runtime. Point this at another volume if the
# store should not live beside the app.
# UPLOADS_DIR=/var/www/alfierayner-uploads
